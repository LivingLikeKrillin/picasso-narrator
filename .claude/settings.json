{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -S -E \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check_commit_format.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -S -E \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/boundary_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -S -E \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/goldenset_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
